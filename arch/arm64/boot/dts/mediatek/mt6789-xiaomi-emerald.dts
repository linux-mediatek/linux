/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/usb/pd.h>
#include <dt-bindings/regulator/mediatek,mt6397-regulator.h>
#include <dt-bindings/pinctrl/mediatek,mt6789-pinfunc.h>

#include "mt6789.dtsi"

/ {
	chassis-type = "handset";
	compatible = "xiaomi,emerald", "mediatek,mt6789";
	model = "Redmi Note 13 Pro 4G";

	aliases {
		mmc1 = &mmc1;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		simplefb: framebuffer@fe0d0000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfe0d0000 0x0 ((1080 + 8) * 2400 * 4)>;
			width = <1080>;
			height = <2400>;
			stride = <((1080 + 8) * 4)>;
			format = "a8r8g8b8";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-volume-up {
			gpios = <&pio 66 GPIO_ACTIVE_HIGH>;
			label = "volume_down";
			linux,code = <KEY_VOLUMEDOWN>;
			wakeup-source;
			debounce-interval = <15>;
		};
	};

	battery: battery {
		/* dual-cell battery */
		compatible = "simple-battery";

		device-chemistry = "lithium-ion-polymer";

		voltage-min-design-microvolt = <3890000>;
		voltage-max-design-microvolt = <4450000>;

		energy-full-design-microwatt-hours = <19400000>;
		charge-full-design-microamp-hours = <5000000>;

		constant-charge-current-max-microamp = <16000000>;
		constant-charge-voltage-max-microvolt = <4740000>;
	};
};

&cpu0 {
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_others_reg>;
};

&cpu1 {
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_others_reg>;
};

&cpu2 {
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_others_reg>;
};

&cpu3 {
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_others_reg>;
};

/* FIXME: Enabling more than 4 CPUs causes weird hangs in many places */
&cpu4 {
	status = "disabled";
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_others_reg>;
};

&cpu5 {
	status = "disabled";
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_others_reg>;
};

&cpu6 {
	status = "disabled";
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc12_reg>;
	sram-supply = <&mt6366_vsram_others_reg>;
};

&cpu7 {
	status = "disabled";
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc12_reg>;
	sram-supply = <&mt6366_vsram_others_reg>;
};

&spi1 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;

	/* There are two variants of touchscreen
	 * focaltech found in Huaxing panel variant (42)
	 * goodix found in Visionox panel variant (41) */

	/* focaltech,ft3683g */
	/* goodix,9916r */
};

&dsi0 {
	/* FIXME: mediatek-drm causes kernel panic for now */
	status = "disabled";
	#address-cells = <1>;
	#size-cells = <0>;

	panel: panel@0 {
		compatible = "xiaomi,emerald-huaxing";
		reg = <0>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	ports {
		port {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&i2c3 {
	status = "okay";

	nfc@28 {
		/* There is no driver */
		compatible = "nxp,pn557-i2c";
		reg = <0x28>;

		interrupts-extended = <&pio 1 IRQ_TYPE_LEVEL_HIGH>;

		enable-gpios = <&pio 100 GPIO_ACTIVE_HIGH>;
		firmware-gpios = <&pio 108 GPIO_ACTIVE_HIGH>;
		clkfreq-gpios = <&pio 68 GPIO_ACTIVE_HIGH>;
	};
};

&i2c5 {
	status = "okay";
