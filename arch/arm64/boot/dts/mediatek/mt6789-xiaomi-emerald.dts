							PDO_FIXED_USB_COMM |
							PDO_FIXED_DATA_SWAP)
							PDO_VAR(5000, 12000, 5000)>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					sc6601_hs_in: port@0 {
						reg = <0>;
						endpoint {
							remote-endpoint = <&usb2_hs_out>;
						};
					};
				};
			};
		};
	};

	*/
	
	/* flashlight,lm3643 @ 63 */
};

&i2c6 {
	status = "okay";
	/* unknown-ldo @ 28 */
	/* haptic,aw86224 @ 58 */
	/* southchip,sc8541-master @ 6a */
};

&i2c7 {
	status = "okay";

	bq28z610: fuel-gauge@55 {
		compatible = "ti,bq28z610";
		reg = <0x55>;
		monitored-battery = <&battery>;
	};

	/* southchip,sc8541-slave @ 6a */

};

&i2c8 {
	status = "okay";
};

&usb2 {
	status = "okay";

	dr_mode = "peripheral";
	maximum-speed = "high-speed";

	//usb-role-switch;
	//role-switch-default-mode = "peripheral";
/* 
	port {
		usb2_hs_out: endpoint {
			remote-endpoint = <&sc6601_hs_in>;
		};
	};*/
};

&u2phy {
	status = "okay";
};

/* FIXME: GPIO73 is requested by phantom device */
/*
[    2.101743] mt6789-pinctrl 10005000.pinctrl: pin GPIO73 already requested by 11240000\x9a\xc9C\x93\xd2\xdb\x12\xdcserial8250:0; cannot claim for 11240000.mmc
*/
&mmc1 {
	status = "okay";

	/*pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;*/

	bus-width = <1>;

	max-frequency = <200000000>;

	cap-sd-highspeed;
	//sd-uhs-sdr12;
	//sd-uhs-sdr25;
	sd-uhs-sdr50;
	//sd-uhs-sdr104;
	sd-uhs-ddr50;

	//cd-debounce-delay-ms = <0>;
	//cd-gpios = <&pio 7 GPIO_ACTIVE_HIGH>;

	//vmmc-supply = <&reg_vqmmc_dummy>;
	//vqmmc-supply = <&reg_vqmmc_dummy>;
	vmmc-supply = <&mt6366_vmch_reg>;
	vqmmc-supply = <&mt6366_vmc_reg>;
};

&ufsphy {
	status = "okay";
};

&ufs {
	status = "okay";

	vcc-supply = <&mt6366_vemc_reg>;
};

&pio {
	/*
	mmc1_pins_default: mmc1-pins-default-state {
		pins-clk {
			pinmux = <PINMUX_GPIO71__FUNC_MSDC1_CLK>;
			drive-strength = <3>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-cmd-dat {
			pinmux = <PINMUX_GPIO73__FUNC_MSDC1_DAT0>,
					 <PINMUX_GPIO74__FUNC_MSDC1_DAT1>,
					 <PINMUX_GPIO75__FUNC_MSDC1_DAT2>,
					 <PINMUX_GPIO76__FUNC_MSDC1_DAT3>,
					 <PINMUX_GPIO72__FUNC_MSDC1_CMD>;
