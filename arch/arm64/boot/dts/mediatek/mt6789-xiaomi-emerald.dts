						  <&sc6601_adc SC6601_ADC_CHAN_VBAT>;

			sc6601_otg_vbus_reg: usb-otg-vbus-regulator {
				regulator-name = "sc6601-otg-vbus";
				regulator-min-microvolt = <5000000>;
