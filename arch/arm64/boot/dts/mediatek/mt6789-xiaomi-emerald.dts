/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/usb/pd.h>
#include <dt-bindings/regulator/mediatek,mt6397-regulator.h>
#include <dt-bindings/pinctrl/mediatek,mt6789-pinfunc.h>

#include "mt6789.dtsi"

/ {
	chassis-type = "handset";
	compatible = "xiaomi,emerald", "mediatek,mt6789";
	model = "Xiaomi Redmi Note 13 Pro 4G";

	aliases {
		mmc1 = &mmc1;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		simplefb: framebuffer@fe0d0000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xfe0d0000 0x0 ((1080 + 8) * 2400 * 4)>;
			width = <1080>;
			height = <2400>;
			stride = <((1080 + 8) * 4)>;
			format = "a8r8g8b8";

			panel = <&panel>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-volume-down {
			gpios = <&pio 66 GPIO_ACTIVE_LOW>;
			label = "volume_down";
			linux,code = <KEY_VOLUMEDOWN>;
			wakeup-source;
			debounce-interval = <100>;
		};
	};

	battery: battery {
		/* dual-cell battery */
		compatible = "simple-battery";

		device-chemistry = "lithium-ion-polymer";

		voltage-min-design-microvolt = <3890000>;
		voltage-max-design-microvolt = <4450000>;

		energy-full-design-microwatt-hours = <19400000>;
		charge-full-design-microamp-hours = <5000000>;

		constant-charge-current-max-microamp = <16000000>;
		constant-charge-voltage-max-microvolt = <4740000>;
	};

	avdd_ts: regulator-avdd-ts {
		compatible = "regulator-fixed";
		regulator-name = "vreg_avdd_ts";

		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		regulator-enable-ramp-delay = <10>;

		gpio = <&pio 53 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	iovdd_ts: regulator-iovdd-ts {
		compatible = "regulator-fixed";
		regulator-name = "vreg_iovdd_ts";

		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		regulator-enable-ramp-delay = <10>;

		gpio = <&pio 157 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	disp_vddi: regulator-disp-vddi {
		compatible = "regulator-fixed";
		regulator-name = "vreg_disp_vddi";

		gpio = <&pio 156 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on; /* until panel bringup */
	};

	disp_vdd: regulator-disp-vdd {
		compatible = "regulator-fixed";
		regulator-name = "vreg_disp_vdd";

		gpio = <&pio 14 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on; /* until panel bringup */
	};

	disp_vci: regulator-disp-vci {
		compatible = "regulator-fixed";
		regulator-name = "vreg_disp_vci";

		gpio = <&pio 155 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on; /* until panel bringup */
	};

	/* system wide semi-regulated power rail from vbat */
	reg_vsys: regulator-vsys {
		compatible = "regulator-fixed";
		regulator-name = "vsys";
		regulator-always-on;
		regulator-boot-on;
	};
};

&cpu0 {
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_proc11_reg>;
};

&cpu1 {
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_proc11_reg>;
};

&cpu2 {
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_proc11_reg>;
};

&cpu3 {
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_proc11_reg>;
};

/* FIXME: Enabling more than 4 CPUs causes weird hangs at boot,
 * CPU4 and CPU5 can be enabled after boot by writing 1 to:
 * /sys/devices/system/cpu/cpu4/online
 * /sys/devices/system/cpu/cpu5/online
 * CPU6 and CPU7 are fails to boot due some capability conflicts
 */
&cpu4 {
	status = "disabled";
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_proc11_reg>;
};

&cpu5 {
	status = "disabled";
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc11_reg>;
	sram-supply = <&mt6366_vsram_proc11_reg>;
};

&cpu6 {
	status = "disabled";
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc12_reg>;
	sram-supply = <&mt6366_vsram_proc12_reg>;
};

&cpu7 {
	status = "disabled";
	cpu-supply = <&mt6366_vcore_reg>;
	proc-supply = <&mt6366_vproc12_reg>;
	sram-supply = <&mt6366_vsram_proc12_reg>;
};

&spi1 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;

	/* There are two variants of touchscreen
	 * focaltech found in Huaxing panel variant (42)
	 * goodix found in Visionox panel variant (41) */

	touchscreen@0 {
		/* ft3683g */
		compatible = "focaltech,ft3680";
		reg = <0x0>;

		spi-max-frequency = <6000000>;

		interrupt-parent = <&pio>;
		interrupts = <9 0x2001>;
		reset-gpios = <&pio 152 GPIO_ACTIVE_HIGH>;
		focaltech,irq-gpio = <&pio 9 0x2001>;
		focaltech,display-coords = <0 0 (1080*16) (2400*16)>;
		focaltech,max-touch-number = <10>;

		vdd-supply = <&avdd_ts>;
		iovdd-supply = <&iovdd_ts>;

		firmware-name = "focaltech/ft3683g_emerald.bin";
	};

	/* goodix,9916r */
};

/* FIXME: any job is invalid:
 * [   80.540914] panfrost 13000000.gpu: js fault, js=0, status=DATA_INVALID_FAULT, head=0xa006480, tail=0xa006480
 */
&gpu {
	status = "disabled";

	mali-supply = <&mt6366_vgpu_reg>;
};

&dsi0 {
	/* FIXME: mediatek-drm can't find any crtc */
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	panel: panel@0 {
		compatible = "xiaomi,emerald-huaxing";
		reg = <0>;

		width-mm = <70>;
		height-mm = <155>;

		reset-gpios = <&pio 85 GPIO_ACTIVE_HIGH>;

		vddi-supply = <&disp_vddi>;
		vdd-supply = <&disp_vdd>;
		vci-supply = <&disp_vci>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	ports {
		port {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "okay";

	nfc@28 {
		compatible = "nxp,pn557",
					 "nxp,nxp-nci-i2c";
		reg = <0x28>;

		interrupts-extended = <&pio 1 IRQ_TYPE_LEVEL_HIGH>;

		enable-gpios = <&pio 100 GPIO_ACTIVE_HIGH>;
		firmware-gpios = <&pio 108 GPIO_ACTIVE_HIGH>;
	};
};

&i2c4 {
	status = "okay";
};

&i2c5 {
	status = "okay";
/*
	spk_left_amp: speaker-amp@58 {
		compatible = "awinic,aw87559";

		reg = <0x58>;

		#sound-dai-cells = <0>;

		reset-gpio = <&pio 153 GPIO_ACTIVE_HIGH>;
	};

	spk_right_amp: speaker-amp@5b {
		compatible = "awinic,aw87559";

		reg = <0x5b>;

		#sound-dai-cells = <0>;

		reset-gpio = <&pio 67 GPIO_ACTIVE_HIGH>;
	};
*/
	
	subpmic: sc6601@61 {
		compatible = "southchip,sc6601";
		reg = <0x61>;
		interrupts-extended = <&pio 4 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <1>;
		wakeup-source;

		sc6601_charger: sc6601-charger {
			compatible = "southchip,sc6601-charger";

			monitored-battery = <&battery>;

			interrupts = <0>, <6>;
			interrupt-names = "charger", "hourse_keeping";

			sc6601_otg_vbus_vreg: usb-otg-vbus-regulator {
				regulator-name = "sc6601-otg-vbus";
				regulator-min-microvolt = <5000000>;
				regulator-max-microvolt = <5000000>;
				regulator-min-microamp = <1500000>;
				regulator-max-microamp = <1500000>;
			};
		};
	};

	/*
	 !!! WIP !!!
	subpmic: sc6601@61 {
		compatible = "southchip,sc6601";
		reg = <0x61>;
		interrupts-extended = <&pio 4 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <1>;
		wakeup-source;

		sc6601_adc: sc6601-adc {
			compatible = "southchip,sc6601-adc";
