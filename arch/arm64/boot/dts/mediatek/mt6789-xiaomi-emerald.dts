				regulator-min-microamp = <1500000>;
				regulator-max-microamp = <1500000>;
			};
		};

		sc6601_tcpc: sc6601-tcpc {
			compatible = "southchip,sc6601-tcpc";
			interrupts-extended = <&pio 26 IRQ_TYPE_LEVEL_LOW>;
			wakeup-source;

			connector {
				compatible = "usb-c-connector";
				label = "USB-C";

				self-powered;

				data-role = "dual";
				power-role = "dual";
